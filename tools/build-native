#!/usr/bin/env python3
"""Build and package the current native target; never install into a user profile."""
import hashlib
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tempfile
import zipfile

ROOT = Path(__file__).resolve().parents[1]

def invoke(command, **options):
    return subprocess.check_output(command, cwd=ROOT, **options)

def build():
    manifest = json.loads((ROOT / "manifest.json").read_text())
    cargo = json.loads(invoke(["cargo", "metadata", "--format-version", "1", "--no-deps", "--locked"]))
    triple = next(line.partition(": ")[2] for line in invoke(["rustc", "-vV"], text=True).splitlines() if line.startswith("host: "))
    architecture, _, operating_system, *_ = triple.split("-")
    platform = {"darwin": "macos"}.get(operating_system, operating_system)
    package_target = f"{platform}-{architecture}"
    environment = os.environ.copy()
    home = str(Path.home())
    rustflags = (environment["CARGO_ENCODED_RUSTFLAGS"].split("\x1f") if environment.get("CARGO_ENCODED_RUSTFLAGS")
                 else shlex.split(environment.get("RUSTFLAGS", "")))
    prefixes = [(home, "/build/home")]
    if environment.get("CARGO_TARGET_DIR"):
        prefixes.append((str(Path(environment["CARGO_TARGET_DIR"]).resolve()), "/build/target"))
    prefixes.append((str(ROOT), "/build/source"))
    rustflags += [f"--remap-path-prefix={source}={target}" for source, target in prefixes]
    environment["CARGO_ENCODED_RUSTFLAGS"] = "\x1f".join(rustflags)
    for name in (() if sys.platform == "win32" else ("CFLAGS", "CXXFLAGS")):
        flags = shlex.split(environment.get(name, ""))
        flags += [f"-{kind}-prefix-map={source}={target}" for source, target in prefixes for kind in ("ffile", "fdebug")]
        environment[name] = shlex.join(flags)
    command = ["cargo", "build", "--offline", "--locked", "--release", "--target", triple, "-p", "qobuz-downloader", "--bin", "plugin"]
    if sys.platform.startswith("linux") and not environment.get("PLUGIN_BUILD_LOCK"):
        raise SystemExit("Set PLUGIN_BUILD_LOCK to the machine-wide Rust build lock")
    lock = Path(environment.get("PLUGIN_BUILD_LOCK", str(Path(tempfile.gettempdir()) / "plugin-cargo.lock")))
    capped = Path.home() / ".local/bin/cargo-capped"
    if sys.platform.startswith("linux"):
        if not lock.parent.is_dir() or not capped.is_file() or not shutil.which("flock"):
            raise SystemExit("The shared Rust build lock and cargo-capped are required on Linux")
        command = ["flock", str(lock), str(capped), *command]
    subprocess.run(command, cwd=ROOT, env=environment, check=True)
    executable = "plugin.exe" if sys.platform == "win32" else "plugin"
    destination = ROOT / "dist" / f"{manifest['version']}-{package_target}"
    destination.mkdir(parents=True, exist_ok=True)
    sources = {executable: Path(cargo["target_directory"]) / triple / "release" / executable,
        **{name: ROOT / name for name in ("manifest.json", "icon.svg", "COPYING", "NOTICE")},
        "LICENSE-API": ROOT / "crates/qobuz-api/LICENSE", "LICENSE-MODELS": ROOT / "crates/qobuz-models/LICENSE",
        "LICENSE-MEDIA": ROOT / "crates/media-core/LICENSE"}
    for name, source in sources.items():
        shutil.copy2(source, destination / name)
    archive = destination.parent / f"{destination.name}.zip"
    with zipfile.ZipFile(archive, "w", compression=zipfile.ZIP_DEFLATED) as package:
        for name in sorted(sources):
            package.write(destination / name, name)
    for artifact in (destination / executable, archive):
        print(f"{artifact}\nSHA256 {hashlib.sha256(artifact.read_bytes()).hexdigest()}")

if __name__ == "__main__":
    build()
